<%- include('../partials/header') %>

<div class="px-4 py-6 sm:px-0">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Billing & Credits</h1>
    <p class="text-sm text-gray-500">Manage your credit balance and view usage history.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
    <!-- Balance Card -->
    <div class="bg-blue-600 rounded-lg shadow-lg overflow-hidden text-white p-6">
      <h3 class="text-blue-100 text-sm font-medium uppercase tracking-wider mb-2">Available Credits</h3>
      <div class="text-4xl font-bold mb-4"><%= walletBalance.available.toLocaleString() %></div>
      <div class="flex justify-between text-blue-100 text-xs">
        <span>Reserved for jobs: <%= walletBalance.reserved.toLocaleString() %></span>
        <span>Total: <%= walletBalance.total.toLocaleString() %></span>
      </div>
    </div>

    <!-- Pricing Packs -->
    <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-4">
      <% packages.forEach(pkg => { %>
        <div class="bg-white border rounded-lg p-5 flex flex-col justify-between <%= pkg.isFeatured ? 'ring-2 ring-blue-500 border-blue-500' : 'border-gray-200 shadow-sm' %>">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h4 class="font-bold text-gray-900"><%= pkg.name %></h4>
              <% if (pkg.isFeatured) { %>
                <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-1.5 py-0.5 rounded uppercase">Best Value</span>
              <% } %>
            </div>
            <p class="text-xs text-gray-500 mb-4"><%= pkg.description %></p>
            <div class="text-2xl font-bold text-gray-900 mb-1">
              <%= currency %> <%= (pkg.priceMinor / 100).toLocaleString() %>
            </div>
            <div class="text-sm text-blue-600 font-semibold"><%= pkg.credits.toLocaleString() %> URL Credits</div>
          </div>
          <button class="mt-4 w-full bg-gray-900 text-white text-sm font-medium py-2 rounded-md hover:bg-gray-800">
            Buy Now
          </button>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Ledger History -->
  <div class="bg-white shadow rounded-lg border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">Credit Transaction History</h3>
    </div>
    <% if (ledgerEntries.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>No credit transactions recorded yet.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Balance</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% ledgerEntries.forEach(entry => { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">
                  <%= new Date(entry.createdAt).toLocaleString() %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%
                    let color = 'gray';
                    if (entry.type === 'PURCHASE' || entry.type === 'BONUS' || entry.type === 'REFUND') color = 'green';
                    if (entry.type === 'DEBIT') color = 'red';
                    if (entry.type === 'RESERVE') color = 'yellow';
                  %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-<%= color %>-100 text-<%= color %>-800">
                    <%= entry.type.replace('_', ' ') %>
                  </span>
                </td>
                <td class="px-6 py-4 text-xs text-gray-600 max-w-xs truncate">
                  <%= entry.reason %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right font-medium <%= entry.amount > 0 ? 'text-green-600' : (entry.amount < 0 ? 'text-red-600' : 'text-gray-900') %>">
                  <%= entry.amount > 0 ? '+' : '' %><%= entry.amount === 0 ? '' : entry.amount.toLocaleString() %>
                  <% if (entry.reservedDelta !== 0) { %>
                    <span class="text-[10px] text-gray-400 block font-normal">(<%= entry.reservedDelta > 0 ? '+' : '' %><%= entry.reservedDelta %> reserved)</span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-xs font-semibold text-gray-700">
                  <%= entry.availableAfter.toLocaleString() %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
