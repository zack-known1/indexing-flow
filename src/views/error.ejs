<%- include('partials/header') %>

<div class="min-h-[50vh] flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
    <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-red-100 text-red-600 mb-4 text-3xl">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h2 class="text-3xl font-extrabold text-gray-900"><%= title %></h2>
    <p class="mt-2 text-sm text-gray-500">
      Error Code: <code class="font-mono text-xs bg-gray-100 px-1 py-0.5 rounded text-red-600"><%= error.code %></code>
    </p>
    <p class="mt-4 text-base text-gray-600">
      <%= error.message %>
    </p>
    <div class="mt-6">
      <a href="/" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
        Back to Dashboard
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
