<%- include('../partials/header') %>

<div class="px-4 py-6 sm:px-0">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Tracked URLs</h1>
      <p class="text-sm text-gray-500">View and update the indexing status of your submitted URLs.</p>
    </div>
    <div>
      <a href="/urls/submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
        <i class="fa-solid fa-plus mr-2"></i> Submit URLs
      </a>
    </div>
  </div>

  <!-- Filters and Search Bar -->
  <div class="bg-white p-4 shadow rounded-lg border border-gray-200 mb-6">
    <form action="/urls" method="GET" class="grid grid-cols-1 gap-4 sm:grid-cols-4">
      <div>
        <label for="search" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Search URL</label>
        <input type="text" name="search" id="search" value="<%= filters.search %>" placeholder="Search..." class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm">
      </div>
      <div>
        <label for="propertyId" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Property</label>
        <select id="propertyId" name="propertyId" class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm">
          <option value="">All Properties</option>
          <% properties.forEach(prop => { %>
            <option value="<%= prop.id %>" <%= filters.propertyId === prop.id ? 'selected' : '' %>><%= prop.siteUrl %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="status" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Index Status</label>
        <select id="status" name="status" class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-sm">
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
          <option value="INDEXED" <%= filters.status === 'INDEXED' ? 'selected' : '' %>>Indexed</option>
          <option value="NOT_INDEXED" <%= filters.status === 'NOT_INDEXED' ? 'selected' : '' %>>Not Indexed</option>
          <option value="DISCOVERED_NOT_INDEXED" <%= filters.status === 'DISCOVERED_NOT_INDEXED' ? 'selected' : '' %>>Discovered</option>
          <option value="CRAWLED_NOT_INDEXED" <%= filters.status === 'CRAWLED_NOT_INDEXED' ? 'selected' : '' %>>Crawled</option>
          <option value="UNKNOWN" <%= filters.status === 'UNKNOWN' ? 'selected' : '' %>>Pending check</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
          Filter
        </button>
      </div>
    </form>
  </div>

  <!-- URLs Table -->
  <div class="bg-white shadow rounded-lg border border-gray-200 overflow-hidden">
    <% if (urls.length === 0) { %>
      <div class="p-12 text-center text-gray-500">
        <i class="fa-solid fa-inbox text-4xl mb-3 text-gray-300"></i>
        <p>No URLs match your current filters.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Property</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submission</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Index Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Checked</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200 text-sm">
            <% urls.forEach(url => { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap max-w-sm truncate font-medium text-gray-900">
                  <a href="<%= url.rawUrl %>" target="_blank" class="hover:text-blue-600" title="<%= url.rawUrl %>"><%= url.rawUrl %></a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-gray-500 text-xs">
                  <%= url.property ? url.property.siteUrl : 'None' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (url.submissionStatus === 'SUBMITTED') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Submitted</span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= url.submissionStatus %></span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (url.indexStatus === 'INDEXED') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><i class="fa-solid fa-check mr-1"></i> Indexed</span>
                  <% } else if (url.indexStatus === 'DISCOVERED_NOT_INDEXED' || url.indexStatus === 'CRAWLED_NOT_INDEXED') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"><i class="fa-solid fa-clock mr-1"></i> <%= url.indexStatus.replace(/_/g, ' ') %></span>
                  <% } else if (url.indexStatus === 'UNKNOWN') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Pending check</span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800"><%= url.indexStatus.replace(/_/g, ' ') %></span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-gray-500 text-xs">
                  <%= url.lastCheckedAt ? new Date(url.lastCheckedAt).toLocaleString() : 'Never' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-xs font-medium space-x-2">
                  <form action="/urls/<%= url.id %>/check" method="POST" class="inline">
                    <button type="submit" class="text-blue-600 hover:text-blue-900 bg-blue-50 px-2.5 py-1 rounded border border-blue-200">
                      Check Status
                    </button>
                  </form>
                  <form action="/urls/<%= url.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this URL?');">
                    <button type="submit" class="text-red-600 hover:text-red-900 bg-red-50 px-2 py-1 rounded border border-red-200">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="bg-white px-4 py-3 border-t border-gray-200 flex items-center justify-between sm:px-6">
        <div class="flex-1 flex justify-between sm:hidden">
          <a href="?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&search=<%= filters.search %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 <%= pagination.page <= 1 ? 'pointer-events-none opacity-50' : '' %>">Previous</a>
          <a href="?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&search=<%= filters.search %>" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 <%= pagination.page >= pagination.totalPages ? 'pointer-events-none opacity-50' : '' %>">Next</a>
        </div>
        <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-gray-700">
              Showing page <span class="font-medium"><%= pagination.page %></span> of <span class="font-medium"><%= pagination.totalPages %></span> (<span class="font-medium"><%= pagination.totalCount %></span> total URLs)
            </p>
          </div>
          <div>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
              <a href="?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&search=<%= filters.search %>&propertyId=<%= filters.propertyId %>" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 <%= pagination.page <= 1 ? 'pointer-events-none opacity-50' : '' %>">
                <span class="sr-only">Previous</span>
                <i class="fa-solid fa-chevron-left"></i>
              </a>
              <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-gray-50 text-sm font-medium text-gray-700">
                <%= pagination.page %>
              </span>
              <a href="?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&search=<%= filters.search %>&propertyId=<%= filters.propertyId %>" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 <%= pagination.page >= pagination.totalPages ? 'pointer-events-none opacity-50' : '' %>">
                <span class="sr-only">Next</span>
                <i class="fa-solid fa-chevron-right"></i>
              </a>
            </nav>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
