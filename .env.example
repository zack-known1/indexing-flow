# =============================================================================
# IndexFlow — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# NEVER commit `.env`. It is already listed in .gitignore.
# Every value marked REQUIRED must be set or the app refuses to boot
# (see src/config/env.ts — fail-fast validation is intentional).
# =============================================================================


# -----------------------------------------------------------------------------
# CORE RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=development

# Port the web server listens on. Most PaaS providers inject this for you.
PORT=3000

# REQUIRED. Public base URL of this deployment, no trailing slash.
# Used to build OAuth redirect URIs, email links and payment callbacks.
# Local:      http://localhost:3000
# Production: https://app.yourdomain.com
APP_URL=http://localhost:3000

# Product name shown throughout the UI and in emails.
APP_NAME=IndexFlow

# Trust the X-Forwarded-* headers. Set to 1 when running behind exactly one
# reverse proxy (Railway, Render, Fly, Heroku, nginx). Required for secure
# cookies and correct client IPs in rate limiting. Set to 0 for a direct VPS bind.
TRUST_PROXY=0


# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 14+)
# -----------------------------------------------------------------------------
# REQUIRED. Standard Postgres connection string.
# Local docker:  postgresql://indexflow:indexflow@localhost:5432/indexflow?schema=public
# Managed hosts usually require sslmode=require:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
# Percent-encode special characters in the password (for example + becomes %2B).
DATABASE_URL=postgresql://indexflow:indexflow@localhost:5432/indexflow?schema=public

# Prisma connection pool size per process. Keep web + worker combined below
# your database's max_connections.
DATABASE_POOL_SIZE=10


# -----------------------------------------------------------------------------
# REDIS (6+) — session store, rate limiting, BullMQ job queue
# -----------------------------------------------------------------------------
# REQUIRED. The queue and the rate limiter both depend on this.
# Local docker:  redis://localhost:6379
# Managed (TLS): rediss://default:PASSWORD@HOST:6379
# Must be a connection URL, not a redis-cli command line.
REDIS_URL=redis://localhost:6379

# Namespace prefix so multiple environments can share one Redis instance.
REDIS_PREFIX=indexflow


# -----------------------------------------------------------------------------
# SECRETS — generate fresh values, never reuse across environments
# -----------------------------------------------------------------------------
# Generate each of the two values below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# REQUIRED. Signs session cookies. Minimum 32 characters.
# Rotating this logs every user out.
SESSION_SECRET=replace_me_with_64_hex_chars_from_the_command_above

# REQUIRED. Master key for AES-256-GCM encryption of data at rest:
# Google OAuth refresh tokens and API key secrets.
# Must be exactly 64 hex characters (32 bytes).
# !! LOSING THIS MAKES EVERY STORED OAUTH TOKEN UNRECOVERABLE — back it up
# !! in your secret manager before going to production.
# Do not change this value once encrypted data exists. To rotate, move the old
# value into ENCRYPTION_KEY_PREVIOUS and set the new one here.
ENCRYPTION_KEY=replace_me_with_exactly_64_hex_chars_from_the_command_above

# Optional. Previous ENCRYPTION_KEY, comma-separated, kept during key rotation
# so old ciphertexts can still be decrypted and re-wrapped.
ENCRYPTION_KEY_PREVIOUS=


# -----------------------------------------------------------------------------
# GOOGLE OAUTH + SEARCH CONSOLE
# -----------------------------------------------------------------------------
# Create an OAuth 2.0 "Web application" client in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Full walkthrough: docs/GOOGLE_OAUTH_SETUP.md
#
# Enable these APIs on the same project:
#   - Google Search Console API   (searchconsole.googleapis.com)
#   - Web Search Indexing API     (indexing.googleapis.com)  [optional]

# REQUIRED for Google connection features.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace_me

# REQUIRED. Must match an "Authorized redirect URI" on the OAuth client
# character for character, including scheme and any trailing path.
# Local:      http://localhost:3000/properties/google/callback
# Production: https://app.yourdomain.com/properties/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/properties/google/callback

# Enable the Google Indexing API integration.
# IMPORTANT: Google's Indexing API officially supports ONLY JobPosting and
# BroadcastEvent structured-data URLs. IndexFlow enforces this per property —
# see docs/GOOGLE_OAUTH_SETUP.md. Leave false if you have no such pages.
GOOGLE_INDEXING_API_ENABLED=false

# Daily quota guards. Defaults mirror Google's published per-property limits.
# IndexFlow stops submitting and reports QUOTA_LIMITED instead of retrying blindly.
GOOGLE_INSPECTION_DAILY_QUOTA=2000
GOOGLE_INSPECTION_PER_MINUTE_QUOTA=600
GOOGLE_INDEXING_DAILY_QUOTA=200


# -----------------------------------------------------------------------------
# PAYMENTS — Razorpay
# -----------------------------------------------------------------------------
# Dashboard -> Settings -> API Keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Full walkthrough: docs/PAYMENTS_SETUP.md
PAYMENT_PROVIDER=razorpay

# Test keys start with rzp_test_, live keys with rzp_live_.
PAYMENT_PROVIDER_KEY=rzp_test_replace_me
PAYMENT_PROVIDER_SECRET=replace_me

# REQUIRED for payments. Set when you create the webhook endpoint at
# Dashboard -> Settings -> Webhooks. This is a value YOU choose, not one
# Razorpay generates. It must match exactly.
# Webhook URL to register:  {APP_URL}/webhooks/razorpay
# Events to subscribe to:   order.paid, payment.captured, payment.failed, refund.processed
PAYMENT_WEBHOOK_SECRET=replace_me_with_a_long_random_string

# Billing currency (ISO 4217). Razorpay India defaults to INR.
BILLING_CURRENCY=INR

# Tax rate applied to credit pack purchases, in percent. 18 = Indian GST.
# Set to 0 to show tax-inclusive prices instead.
BILLING_TAX_PERCENT=18

# Your legal/tax identifiers, printed on invoices. Leave blank to omit.
BILLING_COMPANY_NAME=
BILLING_COMPANY_ADDRESS=
BILLING_GSTIN=


# -----------------------------------------------------------------------------
# EMAIL (transactional)
# -----------------------------------------------------------------------------
# Supported drivers: smtp | console | none
#   console — prints emails to the log. Perfect for local development.
#   none    — silently drops email. Verification links appear in the audit log.
EMAIL_DRIVER=console

EMAIL_FROM="IndexFlow <no-reply@yourdomain.com>"

# Only needed when EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
# Generic name kept for compatibility with hosted providers that call this
# an "API key" (SendGrid, Postmark, Resend, Mailgun all accept SMTP creds).
EMAIL_PROVIDER_KEY=


# -----------------------------------------------------------------------------
# ADMIN BOOTSTRAP
# -----------------------------------------------------------------------------
# REQUIRED. The user with this email is granted platform-admin rights by
# `npm run db:seed`. Change it before seeding a production database.
ADMIN_EMAIL=admin@yourdomain.com

# Only used by the seed script to create the initial admin login.
# Must satisfy the 12-character password policy. Change it after first login.
ADMIN_INITIAL_PASSWORD=ChangeMe_AtOnce_2026


# -----------------------------------------------------------------------------
# PRODUCT LIMITS — safe defaults, all overridable at runtime from the
# admin panel (system_settings table takes precedence over these)
# -----------------------------------------------------------------------------
# Credits charged per billable operation.
CREDIT_COST_SUBMIT=1
CREDIT_COST_STATUS_CHECK=1
CREDIT_COST_PRECHECK=0

# Free credits granted to a newly created workspace.
SIGNUP_BONUS_CREDITS=100

# Maximum URLs accepted in a single bulk submission.
MAX_BULK_URLS=10000

# Maximum URLs a single workspace may process per rolling 24 hours.
MAX_DAILY_URLS_PER_WORKSPACE=25000

# Simultaneous in-flight jobs per workspace. Prevents one tenant starving others.
MAX_CONCURRENT_JOBS_PER_WORKSPACE=5

# Upload limits for CSV/TXT imports.
MAX_UPLOAD_SIZE_MB=10

# Job retry policy. Retries use exponential backoff and are hard-capped;
# exhausted jobs move to the dead-letter queue and reserved credits are refunded.
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=30000

# Worker concurrency per worker process.
WORKER_CONCURRENCY=5

# Days of job/URL history retained before the cleanup worker prunes it.
# 0 disables automatic pruning.
DATA_RETENTION_DAYS=365


# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Pretty-print logs instead of JSON. Development only.
LOG_PRETTY=true

# Optional. Sentry DSN for error tracking. Leave blank to disable.
SENTRY_DSN=

# Protects /metrics with a bearer token. Leave blank to disable the endpoint.
METRICS_TOKEN=
